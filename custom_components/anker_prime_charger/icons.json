{
  "entity": {
    "button": {
      "refresh": {
        "default": "mdi:refresh"
      }
    },
    "event": {
      "hidden_animation": {
        "default": "mdi:party-popper"
      }
    },
    "number": {
      "display_brightness": {
        "default": "mdi:brightness-6"
      },
      "timer_duration": {
        "default": "mdi:timer-cog-outline"
      }
    },
    "select": {
      "clock_display_days_preset": {
        "default": "mdi:calendar-week"
      },
      "schedule_start_days_preset": {
        "default": "mdi:calendar-week"
      },
      "schedule_end_days_preset": {
        "default": "mdi:calendar-week"
      },
      "usage_mode": {
        "default": "mdi:lightning-bolt",
        "state": {
          "ai_power": "mdi:creation",
          "port_priority": "mdi:priority-high",
          "dual_laptop": "mdi:laptop",
          "low_power": "mdi:power-sleep"
        }
      },
      "display_timeout_mode": {
        "default": "mdi:timer-sand",
        "state": {
          "never": "mdi:monitor"
        }
      },
      "knob_mode": {
        "default": "mdi:knob",
        "state": {
          "forward": "mdi:rotate-right",
          "backward": "mdi:rotate-left"
        }
      },
      "clock_mode": {
        "default": "mdi:clock-digital",
        "state": {
          "12h": "mdi:hours-12",
          "24h": "mdi:hours-24"
        }
      },
      "port_priority": {
        "default": "mdi:priority-high",
        "state": {
          "off": "mdi:priority-low"
        }
      },
      "clock_theme": {
        "default": "mdi:palette"
      },
      "custom_power_limit": {
        "default": "mdi:flash"
      },
      "custom_protocols_preset": {
        "default": "mdi:protocol"
      }
    },
    "sensor": {
      "unlocked_animations": {
        "default": "mdi:trophy"
      },
      "screen_page": {
        "default": "mdi:monitor",
        "state": {
          "power": "mdi:flash",
          "clock": "mdi:clock-outline",
          "off": "mdi:monitor-off"
        }
      }
    },
    "switch": {
      "usb_c_port": {
        "default": "mdi:usb-c-port"
      },
      "usb_a_port": {
        "default": "mdi:usb-port"
      },
      "clock_switch": {
        "default": "mdi:clock-outline",
        "state": {
          "off": "mdi:clock-remove-outline"
        }
      },
      "time_display": {
        "default": "mdi:clock-time-four-outline"
      },
      "holiday_switch": {
        "default": "mdi:pine-tree"
      },
      "auto_exit_switch": {
        "default": "mdi:exit-run"
      },
      "fast_updates": {
        "default": "mdi:speedometer",
        "state": {
          "off": "mdi:speedometer-slow"
        }
      },
      "compatibility_status": {
        "default": "mdi:handshake-outline"
      },
      "charging_mode_status": {
        "default": "mdi:tune-variant"
      },
      "charging_device_identity_status": {
        "default": "mdi:card-account-details-outline"
      },
      "timer": {
        "default": "mdi:timer-outline",
        "state": {
          "off": "mdi:timer-off-outline"
        }
      },
      "schedule_start": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-remove-outline"
        }
      },
      "schedule_end": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-remove-outline"
        }
      }
    },
    "text": {
      "clock_display_days": {
        "default": "mdi:calendar-week"
      },
      "schedule_start_days": {
        "default": "mdi:calendar-week"
      },
      "schedule_end_days": {
        "default": "mdi:calendar-week"
      },
      "label": {
        "default": "mdi:label-outline"
      },
      "a1_label": {
        "default": "mdi:label-outline"
      },
      "a2_label": {
        "default": "mdi:label-outline"
      },
      "custom_protocols": {
        "default": "mdi:protocol"
      }
    },
    "time": {
      "clock_display_start": {
        "default": "mdi:clock-start"
      },
      "clock_display_end": {
        "default": "mdi:clock-end"
      },
      "schedule_start_time": {
        "default": "mdi:clock-start"
      },
      "schedule_end_time": {
        "default": "mdi:clock-end"
      }
    }
  },
  "services": {
    "save_custom_profile": {
      "service": "mdi:content-save"
    },
    "create_custom_profile": {
      "service": "mdi:plus-box"
    },
    "delete_custom_profile": {
      "service": "mdi:delete"
    },
    "set_custom_settings": {
      "service": "mdi:tune"
    },
    "set_days": {
      "service": "mdi:calendar-week"
    },
    "set_protocols": {
      "service": "mdi:protocol"
    },
    "add_clock_image": {
      "service": "mdi:image-plus"
    },
    "rename_clock_image": {
      "service": "mdi:image-edit"
    },
    "delete_clock_image": {
      "service": "mdi:image-remove"
    },
    "list_clock_images": {
      "service": "mdi:image-multiple"
    }
  }
}
